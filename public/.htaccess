<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Frontend Vue (public/app, hasil `npm run build:laravel`):
    # URL halaman (/, /jadwal, /admin/users, ...) langsung diarahkan ke app/index.html tanpa
    # melewati PHP. URL API, health check, dan file yang benar-benar ada tidak terpengaruh.
    RewriteCond %{DOCUMENT_ROOT}/app/index.html -f
    RewriteRule ^$ app/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/(api|up|storage)(/|$)
    RewriteCond %{DOCUMENT_ROOT}/app/index.html -f
    RewriteRule ^ app/index.html [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # index.html frontend selalu dicek ulang agar versi terbaru langsung terpakai setelah deploy.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Aset hasil build Vite memakai hash di nama file, aman di-cache lama.
    <If "%{REQUEST_URI} =~ m#^/app/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
